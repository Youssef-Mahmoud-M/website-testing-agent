{
  "name": "website-testing-agent",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "node server/index.js",
    "dev": "node server/index.js --dev",
    "serve:prod": "ng build && node server/index.js"
  },
  "private": true,
  "dependencies": {
    "express": "^5.3.0",
    "playwright": "^1.64.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "description": "Human-in-the-loop web testing agent as a website: explore a page, design tests with a reviewer, generate Playwright tests.",
  "author": {
    "name": "Youssef Abdelfattah",
    "email": "mabdelfattah@4sw.app"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  }
}
